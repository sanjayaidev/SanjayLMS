{
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/my-courses", "destination": "/my-courses.html" },
    { "source": "/course/:id", "destination": "/course-detail.html" },
    { "source": "/video/:courseId/:moduleId", "destination": "/video-view.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/checkout-status", "destination": "/checkout-status.html" },
    { "source": "/api/create-order", "destination": "/api/create-order.js" },
    { "source": "/api/verify-order", "destination": "/api/verify-order.js" },
    { "source": "/api/enroll-free", "destination": "/api/enroll-free.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
